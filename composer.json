{
    "name": "sajed-zarinpour/meloquent",
    "description": "provides extra functionality for elloquent",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "library",
        "mellonquent"
    ],
    "homepage": "https://github.com/sajed-zarrinpour/meloquent/",
    "support": {
        "issues": "https://github.com/sajed-zarrinpour/meloquent/issues",
        "source": "https://github.com/sajed-zarrinpour/meloquent/",
        "docs": "https://github.com/sajed-zarrinpour/meloquent/",
        "rss": "https://github.com/sajed-zarrinpour/meloquent/releases.atom",
        "security": "https://github.com/sajed-zarrinpour/meloquent/security/advisories"
    },
    "autoload": {
        "psr-4": {
            "SajedZarinpour\\Meloquent\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Sajed Zarinpour",
            "email": "sajed.zarinpour@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "SajedZarinpour\\Meloquent\\Providers\\MeloquentServiceProvider"
            ],
            "aliases": {
                "Meloquent": "SajedZarinpour\\Meloquent\\Facades\\Meloquent"
            }
        }
    },
    "require": {
    "php": "^8.0",
    "ext-curl": "*"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0",
    "pestphp/pest": "^1.0",
    "pestphp/pest-plugin": "^1.0",
    "nunomaduro/collision": "^7.0"
  },
  "autoload-dev": {
    "psr-4": {
      "SajedZarinpour\\Meloquent\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
    
}
